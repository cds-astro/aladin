<project name="deps" default="resolve" basedir="." xmlns:ivy="antlib:org.apache.ivy.ant">
    <property name="qa.dir" value="qa-lib"/>
    <path id="ivy.lib.path">
        <fileset dir="${qa.dir}" includes="ivy.jar"/>
    </path>
    <taskdef resource="org/apache/ivy/ant/antlib.xml" uri="antlib:org.apache.ivy.ant" classpathref="ivy.lib.path"/>
    <target name="resolve">
        <ivy:retrieve pattern="${qa.dir}/[artifact]-[revision](-[classifier]).[ext]" symlink="false" overwriteMode="always" />
    </target>
</project>
